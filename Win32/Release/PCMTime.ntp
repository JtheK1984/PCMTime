        <item name="qry_Day" type="TFDQuery">
          <row id="SQL.Strings[0]" si="10834" excluded="1">/*Select Datum, Tag, Sollstunden, </row>
          <row id="SQL.Strings[1]" si="10835" excluded="1">SEC_TO_TIME((ArbeitszeitI + PausenI)*60) as Tagesbrutto,</row>
          <row id="SQL.Strings[2]" si="10836" excluded="1">SEC_TO_TIME(ArbeitszeitI*60) as Tagesnetto,</row>
          <row id="SQL.Strings[3]" si="10837" excluded="1">Mehrarbeit AS Mehrarbeit,</row>
          <row id="SQL.Strings[4]" si="10838" excluded="1">SEC_TO_TIME(PausenI*60) as Pause, Fehltag, Feiertag, </row>
          <row id="SQL.Strings[5]" si="10839" excluded="1">if(Buchungsart = -1,'', if(Buchungsart = 0 , 'Büro','Homeoffice')) as BA</row>
          <row id="SQL.Strings[6]" si="10840" excluded="1">from manager_Buchungen*/</row>
          <row id="SQL.Strings[7]" si="10841" excluded="1">SELECT </row>
          <row id="SQL.Strings[8]" si="10842" excluded="1">ID,Datum, Tag, </row>
          <row id="SQL.Strings[9]" si="10843" excluded="1">Kommen, Gehen,</row>
          <row id="SQL.Strings[10]" si="10844" excluded="1">Pause1Beginn,</row>
          <row id="SQL.Strings[11]" si="10845" excluded="1">Pause1Ende,</row>
          <row id="SQL.Strings[12]" si="10846" excluded="1">Pause2Beginn,</row>
          <row id="SQL.Strings[13]" si="10847" excluded="1">Pause2Ende,</row>
          <row id="SQL.Strings[14]" si="10848" excluded="1">MinToHour(Sollstundeni) AS SollStundenStd,</row>
          <row id="SQL.Strings[15]" si="10849" excluded="1">Round(Sollstundeni / 60,2) AS SollStundenDez,</row>
          <row id="SQL.Strings[16]" si="10850" excluded="1">MinToHour(Arbeitszeiti) AS NettoStd,</row>
          <row id="SQL.Strings[17]" si="10851" excluded="1">Round(Arbeitszeiti / 60,2) AS NettoDez,</row>
          <row id="SQL.Strings[18]" si="10852" excluded="3"></row>
          <row id="SQL.Strings[19]" si="10853" excluded="1">MinToHour(Arbeitszeiti  + Pauseni) AS BruttotStd,</row>
          <row id="SQL.Strings[20]" si="10854" excluded="1">Round((Arbeitszeiti + Pauseni) / 60,2) AS BruttoDez,</row>
          <row id="SQL.Strings[21]" si="10855" excluded="3"></row>
          <row id="SQL.Strings[22]" si="10856" excluded="1">MinToHour(Pauseni) AS PausenStd,</row>
          <row id="SQL.Strings[23]" si="10857" excluded="1">Round(Pauseni / 60,2) AS PausenDez,</row>
          <row id="SQL.Strings[24]" si="10858" excluded="3"></row>
          <row id="SQL.Strings[25]" si="10859" excluded="1">MinToHour(Mehrarbeiti) AS MehrarbeitStd,</row>
          <row id="SQL.Strings[26]" si="10860" excluded="1">Round(Mehrarbeiti / 60,2) AS MehrarbeitDez,</row>
          <row id="SQL.Strings[27]" si="10861" excluded="1">Buchungsart,</row>
          <row id="SQL.Strings[28]" si="10862" excluded="1">
            <value>Feiertag, </value>
            <lang id="en" st="4" or="5" rw="0" time="20250728T122836Z" fuzzy="99">Holiday, </lang>
          </row>
          <row id="SQL.Strings[29]" si="10863" excluded="1">Fehltag</row>
          <row id="SQL.Strings[30]" si="10864" excluded="1">From time_Buchungen</row>
          <row id="Left">552</row>
          <row id="Top">336</row>
        </item>

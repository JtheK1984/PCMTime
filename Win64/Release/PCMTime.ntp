        <item name="qry_Day" type="TFDQuery" st="0">
          <row id="SQL.Strings[0]" si="26874" st="0">/*Select Datum, Tag, Sollstunden, </row>
          <row id="SQL.Strings[1]" si="26875" st="0">SEC_TO_TIME((ArbeitszeitI + PausenI)*60) as Tagesbrutto,</row>
          <row id="SQL.Strings[2]" si="26876" st="0">SEC_TO_TIME(ArbeitszeitI*60) as Tagesnetto,</row>
          <row id="SQL.Strings[3]" si="26877" st="0">Mehrarbeit AS Mehrarbeit,</row>
          <row id="SQL.Strings[4]" si="26878" st="0">SEC_TO_TIME(PausenI*60) as Pause, Fehltag, Feiertag, </row>
          <row id="SQL.Strings[5]" si="26879" st="0">if(Buchungsart = -1,'', if(Buchungsart = 0 , 'Büro','Homeoffice')) as BA</row>
          <row id="SQL.Strings[6]" si="26880" st="0">from manager_Buchungen*/</row>
          <row id="SQL.Strings[7]" si="26881" st="0">SELECT </row>
          <row id="SQL.Strings[8]" si="26882" st="0">ID,Datum, Tag, </row>
          <row id="SQL.Strings[9]" si="26883" st="0">Kommen, Gehen,</row>
          <row id="SQL.Strings[10]" si="26884" st="0">Pause1Beginn,</row>
          <row id="SQL.Strings[11]" si="26885" st="0">Pause1Ende,</row>
          <row id="SQL.Strings[12]" si="26886" st="0">Pause2Beginn,</row>
          <row id="SQL.Strings[13]" si="26887" st="0">Pause2Ende,</row>
          <row id="SQL.Strings[14]" si="26888" st="0">MinToHour(Sollstundeni) AS SollStundenStd,</row>
          <row id="SQL.Strings[15]" si="26889" st="0">Round(Sollstundeni / 60,2) AS SollStundenDez,</row>
          <row id="SQL.Strings[16]" si="26890" st="0">MinToHour(Arbeitszeiti) AS NettoStd,</row>
          <row id="SQL.Strings[17]" si="26891" st="0">Round(Arbeitszeiti / 60,2) AS NettoDez,</row>
          <row id="SQL.Strings[18]" si="26892" st="0" excluded="3"></row>
          <row id="SQL.Strings[19]" si="26893" st="0">MinToHour(Arbeitszeiti  + Pauseni) AS BruttotStd,</row>
          <row id="SQL.Strings[20]" si="26894" st="0">Round((Arbeitszeiti + Pauseni) / 60,2) AS BruttoDez,</row>
          <row id="SQL.Strings[21]" si="26895" st="0" excluded="3"></row>
          <row id="SQL.Strings[22]" si="26896" st="0">MinToHour(Pauseni) AS PausenStd,</row>
          <row id="SQL.Strings[23]" si="26897" st="0">Round(Pauseni / 60,2) AS PausenDez,</row>
          <row id="SQL.Strings[24]" si="26898" st="0" excluded="3"></row>
          <row id="SQL.Strings[25]" si="26899" st="0">MinToHour(Mehrarbeiti) AS MehrarbeitStd,</row>
          <row id="SQL.Strings[26]" si="26900" st="0">Round(Mehrarbeiti / 60,2) AS MehrarbeitDez,</row>
          <row id="SQL.Strings[27]" si="26901" st="0">Buchungsart,</row>
          <row id="SQL.Strings[28]" si="26902" st="0">Feiertag, </row>
          <row id="SQL.Strings[29]" si="26903" st="0">Fehltag</row>
          <row id="SQL.Strings[30]" si="26904" st="0">From time_Buchungen</row>
          <row id="Left" st="0">552</row>
          <row id="Top" st="0">336</row>
        </item>
